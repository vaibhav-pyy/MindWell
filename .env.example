# MindWell configuration. Copy to `.env` (same folder) and fill in values.
# NEVER commit .env. This example file contains no real secrets.

# --- Core (required) ---------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
# Set true when served over HTTPS (production)
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=8
SESSION_IDLE_MINUTES=60

# --- MySQL (required) --------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mindwell
MYSQL_USER=mindwell
MYSQL_PASSWORD=
# Alternatively give a full SQLAlchemy URL (overrides the MYSQL_* values):
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/mindwell?charset=utf8mb4

# --- Google Gemini (required for chat, AI activities and AI class insights) ---
# Get a key at https://aistudio.google.com/apikey . Without it the app runs and shows a clear "AI not configured" state.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried if the primary model stays unavailable (HTTP 5xx) after retries; leave empty to disable
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_MAX_RETRIES=2
# Gemini 3.x reasoning effort (minimal|low|medium|high); thinking tokens count against output limits
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=30
CHAT_CONTEXT_MESSAGES=12
MEMORY_SUMMARIES_IN_CONTEXT=3

# --- Gamification ---------------------------------------------------------
XP_CHECKIN=10
XP_PER_ACTIVITY_MINUTE=3
XP_ACTIVITY_MIN=5
XP_ACTIVITY_MAX=40
XP_AWARDS_PER_ACTIVITY_PER_DAY=2
LEVEL_XP_STEP=25
ACTIVITY_MIN_COMPLETION_RATIO=0.6

# --- Teacher analytics privacy -------------------------------------------
# Minimum contributing students before any aggregate is shown (never below 3)
MIN_COHORT_SIZE=5

# --- Emergency notifications (optional; nothing is sent unless configured) --
# Email via any SMTP server (e.g. a Gmail/Workspace app password, SendGrid, Mailgun SMTP)
NOTIFY_PROVIDER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
# SMS via Twilio (needs a Twilio account and a number that can send to India)
NOTIFY_PROVIDER_SMS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Development only: write alerts to backend/instance/dev_outbox.log instead of sending (clearly reported as NOT sent)
NOTIFY_DEV_OUTBOX=false
ALERT_COOLDOWN_MINUTES=10
NOTIFY_MAX_ATTEMPTS=2
DEFAULT_PHONE_REGION=IN

# --- Retention (applied by `flask --app wsgi purge-expired`) -------------
CHAT_RETENTION_DAYS=180
ALERT_LOG_RETENTION_DAYS=90

# --- Rate limiting --------------------------------------------------------
RATELIMIT_ENABLED=true
# Use redis://... in production with multiple workers
RATELIMIT_STORAGE_URI=memory://
